# Database Configuration
MONGODB_URI=mongodb://localhost:27017/sirkonia
# For production, use: mongodb+srv://username:password@cluster.mongodb.net/database

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
# For multiple origins, use comma-separated values: http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Logging
# Options: error, warn, info, debug
LOG_LEVEL=info

# Redis Configuration (if using)
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: Redis password if required
# REDIS_PASSWORD=

# Optional: Redis connection string (alternative to host/port)
# REDIS_URL=redis://localhost:6379
